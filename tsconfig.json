{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // The island still has plain-JS modules (features, toast, imeInput) and
    // JS Vue components; infer their types instead of demanding declarations.
    "allowJs": true,
    // The chat island mirrors the dashboard's `@/` import root.
    "paths": {
      "@/*": ["./src/chatui/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  // Vitest files use Node APIs and are checked by the test runner, not vue-tsc.
  "exclude": ["src/chatui/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
