{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstrBot Launcher",
  "mainBinaryName": "astrbot-launcher-vue",
  "version": "0.1.1",
  "identifier": "com.github.mantoujun12.astrbot-launcher-vue",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AstrBot Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
