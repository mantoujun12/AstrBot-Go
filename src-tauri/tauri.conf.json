{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstrBot Go",
  "mainBinaryName": "astrbot-go",
  "version": "0.5.0",
  "identifier": "com.github.mantoujun12.astrbot-go",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AstrBot Go",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "create": false,
        "visible": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false,
        "hiddenTitle": true,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["sidebar"]
        }
      }
    ],
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEOEYzOTgzODBEODc3MDgKUldRSWQ5aUFnem1QdlY1WFZ1S3VEeTE0TVRFTHpJb3ZFSHlabUFtS0NaakxyT2lqREorb3RLemcK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/mantoujun12/AstrBot-Go/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
