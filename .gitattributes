* text=auto

# Cross-platform source and configuration files
*.c text
*.css text
*.h text
*.html text
*.js text
*.json text
*.jsx text
*.md text
*.rs text
*.scss text
*.toml text
*.ts text
*.tsx text
*.vue text
*.xml text
